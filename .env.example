# Manager (NAS). Replace these with existing absolute host directories.
PUID=1000
PGID=1000
POPCORN_ADMIN_TOKEN=replace-with-a-random-key-at-least-24-characters
POPCORN_BIND=0.0.0.0
POPCORN_PORT=8787
STATE_PATH=/path/to/popcorn/state
LIBRARY_PATH=/path/to/library
OUTPUT_PATH=/path/to/enhanced

# Worker (Spark/desktop). Use the NAS IP or hostname.
POPCORN_MANAGER=http://your-nas:8787
POPCORN_PAIR_CODE=
POPCORN_WORKER_NAME=DGX Spark
WORKER_STATE_PATH=/path/to/popcorn/worker-state
SCRATCH_PATH=/mnt/optane/popcorn-scratch
