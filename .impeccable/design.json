  "narrative": {
    "northStar": "Quiet native workspace",
    "overview": "Make remote processing feel like a simple local library task. Neutral surfaces, familiar controls and plain language let the library and its next useful action lead. The interface earns trust by distinguishing originals from finished copies and showing actual processing state.\n\nThe implemented world uses flat sections, thin dividers and one restrained action color. Recipes, worker pairing and queue actions stay inside the workspace. Motion briefly acknowledges navigation and interaction; system light/dark preference and reduced motion belong to the same world.\n\nThis is a source-led refresh of the approved world for the official Astryx migration. Frontmatter records current source values, including inherited Neutral defaults; it does not declare implementation discrepancies approved. Light-theme component defaults are paired with dark assignments in the schema-2 sidecar. Minimum targets, focus, motion and React wiring also live there because frontmatter cannot express them completely.",
    "keyCharacteristics": [
      "Quiet zinc surfaces with blue actions and dark action text.",
      "Restrained system sans with a clear task hierarchy.",
      "Flat navigation, inline work and thin separators.",
      "Familiar official controls with a 44px minimum target requirement.",
      "System themes and reduced-motion-aware feedback."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Use Action Blue for the next processing action and focus or progress feedback; keep navigation and secondary actions neutral.",
        "section": "colors"
      },
      {
        "name": "The Readable Hierarchy Rule",
        "body": "Reserve headline and title emphasis for task structure; keep paths, formats and status in the supporting text hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Inline Work Rule",
        "body": "Keep recipes, pairing and job actions in their relevant workspace sections, using spacing and dividers to separate steps.",
        "section": "layout"
      },
      {
        "name": "The Flat By Default Rule",
        "body": "Use neutral surfaces and thin dividers for structure; do not add decorative elevation to ordinary workspace sections.",
        "section": "elevation"
      },
      {
        "name": "The Familiar Controls Rule",
        "body": "Preserve the approved minimum 44px interactive target for buttons, navigation, text fields, selectors, checkbox labels and disclosure triggers; verify the clickable element rather than its surrounding panel.",
        "section": "shapes"
      },
      {
        "name": "The Continue The Preview Rule",
        "body": "Let a completed preview continue directly from its job row with saved settings; keep download and choosing another source secondary to that continuation.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** keep actions and focus blue with dark text on filled blue buttons in both themes.",
      "**Do** use neutral surfaces, thin dividers and the approved control/panel shape hierarchy; record source drift honestly.",
      "**Do** preserve official control semantics, visible focus, wrapping paths and the 44px minimum interactive target.",
      "**Do** pair semantic status indicators with readable words and accessible text.",
      "**Do** continue a completed preview from its job row using the saved settings.",
      "**Do** honor system light/dark preference and reduced motion.",
      "**Do** compile the hand-authored theme and regenerate selector policy with the pinned dependency."
    ],
    "donts": [
      "**Don't** turn status colors into additional action colors.",
      "**Don't** add decorative charts, fake activity, gradients or glass to this quiet workspace.",
      "**Don't** make ordinary inline tasks depend on a decorative modal or nested card stack.",
      "**Don't** imply that processing replaces the library original.",
      "**Don't** treat screenshots, device names or mocked capabilities as GPU/AI readiness evidence.",
      "**Don't** promote redundant eyebrows, Unicode icon substitutes or one-off brand measurements into reusable system tokens.",
      "**Don't** edit generated theme/bundle output or extract active tokens from the removed legacy UI.",
      "**Don't** declare accessibility, target sizing or release checks passed from this documentation pass."
    ]
  }
